+// ResetClients закрывает все QUIC-соединения и забывает клиентов (патч приложения VPN).
+// Клиент живёт в глобальной таблице и переживает перезапуск ядра: после смены сети (Wi-Fi <-> LTE,
+// другой адаптер на ПК) он слал бы пакеты со старыми настройками сокета до таймаута простоя.
+func ResetClients() {
+	manger.mutex.Lock()
+	old := manger.m
+	manger.m = make(map[string]*client)
+	manger.mutex.Unlock()
+	for _, c := range old {
+		c.mutex.Lock()
+		if c.conn != nil {
+			c.close()
+		}
+		c.mutex.Unlock()
+	}
+}
