 // HandleConnection pass the connection coming from the ip stack to the routing dispatcher
 func (t *Handler) HandleConnection(conn net.Conn, destination net.Destination) {
+	// защита: паника при обработке одного пакета/соединения не должна ронять весь процесс (весь VPN).
+	// Печатаем стек в лог (stderr) и продолжаем — соединение просто закрывается.
+	defer func() {
+		if r := recover(); r != nil {
+			errors.LogError(t.ctx, errors.New("tun HandleConnection panic to ", destination, ": ", r, "\n", string(debug.Stack())))
+		}
+	}()
